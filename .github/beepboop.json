{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "main": {
      "packages": [],
      "versionScope": "one-for-stream",
      "mustPublish": [],
      "versionSource": {
        "kind": "tags",
        "prefix": ""
      },
      "versionFiles": [
        {
          "path": "Cargo.toml",
          "format": "toml",
          "key": ["package", "version"]
        },
        {
          "path": "schema.json",
          "format": "json",
          "key": ["$id"],
          "template": "https://plugins.dprint.dev/kjanat/tombi/{version}/schema.json"
        }
      ],
      "startFrom": [{ "via": "cli" }, { "via": "dashboard" }],
      "prepare": {
        "strategy": "managed",
        "versionLands": "via-version-pr",
        "workflow": {
          "file": "prepare-release.yml",
          "mode": "dispatch",
          "ref": "refs/heads/master"
        }
      },
      "promote": {
        "workflow": {
          "file": "release.yml",
          "mode": "dispatch",
          "ref": "refs/heads/master",
          "publications": ["github-release:kjanat/dprint-plugin-tombi"],
          "refs": { "phase": "version", "prefix": "", "signed": true }
        }
      },
      "workflows": {
        "tag-release": {
          "file": "release.yml",
          "mode": "observe",
          "ref": "refs/tags/*",
          "publications": ["pkg:github/kjanat/dprint-plugin-tombi"]
        },
        "tombi-update": {
          "file": "release.yml",
          "mode": "observe",
          "ref": "refs/heads/master"
        }
      }
    }
  },
  "managers": ["workflow"],
  "subscriptions": [
    {
      "id": "tombi-release-issue",
      "source": "npm:tombi",
      "event": "package.version.changed",
      "issue": {
        "title": "Update Tombi to v{version}",
        "body": "Update the plugin to [Tombi v{version}](https://www.npmjs.com/package/tombi/v/{version}).\n\nRebase the portability patches onto `v{version}` and push `dprint/v{version}-headless` to `kjanat/tombi`. The updater will open a dependency PR.\n\n[Fork update instructions](https://github.com/kjanat/dprint-plugin-tombi/blob/master/UPSTREAM.md#updating)"
      }
    }
  ]
}
