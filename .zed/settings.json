// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "prettier": { "allowed": false },
  "formatter": [
    { "language_server": { "name": "dprint" } },
    { // Fallback to external dprint command for . (dot) hidden files
      "external": {
        "command": "dprint",
        "arguments": ["fmt", "--stdin", "{buffer_path}"]
      }
    }
  ],
  "languages": {
    "TypeScript": { "language_servers": ["deno"] },
    "TOML": {
      "language_servers": ["tombi", "..."],
      "formatter": "language_server" // {"language_server": { "name": "dprint" } }
    }
  },
  "lsp": {
    "deno": { "enable_lsp_tasks": true },
    "tombi": {
      "binary": {
        "arguments": ["lsp", "-vv"],
        "env": { "NO_COLOR": "true" }
      }
    }
  },
}
