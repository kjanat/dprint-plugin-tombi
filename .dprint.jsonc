{
  // This plugin (enable after building with `cargo wasm --locked`):
  // "toml": {},

  // Other plugins:
  "typescript": {},
  "json": { "trailingCommas": "maintain" },
  "markdown": {
    "textWrap": "always",
    "emphasisKind": "asterisks"
  },
  "malva": {},
  "markup": {},
  "yaml": { "flowMap.preferSingleLine": true, "printWidth": 160 },
  // Exec plugin configuration to run rustfmt
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "exts": ["rs"],
        "cacheKeyFiles": ["rustfmt.toml", "rust-toolchain.toml", ".cargo/config.toml"],
      },
      {
        "cwd": "${configDir}",
        "command": "tombi format - --stdin-filename {{file_path}}",
        "exts": ["toml"],
        "cacheKeyFiles": ["tombi.toml"]
      }
    ],
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/target",
    "**/fixtures",
    "schema.json"
  ],
  "plugins": [
    // "./target/wasm32-unknown-unknown/wasm-release/dprint_plugin_tombi.wasm",
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
  ],
}
