{
  // This plugin (enable after building with `cargo wasm --locked`):
  // "toml": {},

  // Other plugins:
  "typescript": {},
  "json": { "trailingCommas": "maintain" },
  "markdown": {
    "textWrap": "always",
    "emphasisKind": "asterisks"
  },
  "malva": {},
  "markup": {},
  "yaml": { "flowMap.preferSingleLine": true },
  // Exec plugin configuration to run rustfmt
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "exts": ["rs"],
        "cacheKeyFiles": ["rustfmt.toml", "rust-toolchain.toml", ".cargo/config.toml"],
      },
    ],
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/target",
    "tests/fixtures/**",
    "schema.json"
  ],
  "plugins": [
    // "./target/wasm32-unknown-unknown/wasm-release/dprint_plugin_tombi.wasm",
    "https://plugins.dprint.dev/typescript-0.95.13.wasm",
    "https://plugins.dprint.dev/json-0.21.0.wasm",
    "https://plugins.dprint.dev/markdown-0.20.0.wasm",
    "https://plugins.dprint.dev/g-plane/malva-v0.15.1.wasm",
    "https://plugins.dprint.dev/g-plane/markup_fmt-v0.25.3.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.1.wasm",
    "https://plugins.dprint.dev/exec-0.6.0.json@a054130d458f124f9b5c91484833828950723a5af3f8ff2bd1523bd47b83b364",
  ],
}
