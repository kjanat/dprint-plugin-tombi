{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Europe/Amsterdam",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am"]
  },
  "packageRules": [
    {
      "description": "Merge non-major updates with GitHub's auto-merge, which waits for the CI checks the master ruleset requires.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require dashboard approval before opening major upgrade PRs.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require a manual merge for lockfile maintenance because a Tombi revision change publishes the plugin.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": false
    }
  ]
}
