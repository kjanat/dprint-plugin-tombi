{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Europe/Amsterdam",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am every day"]
  },
  "customManagers": [
    {
      "description": "Tombi version from the kjanat/tombi fork's dprint/vX.Y.Z-headless branches.",
      "customType": "regex",
      "managerFilePatterns": ["/^Cargo\\.toml$/"],
      "matchStrings": [
        "(?<depName>[a-z_-]+)\\s*=\\s*\\{\\s*git\\s*=\\s*\"https://github\\.com/kjanat/tombi\",\\s*branch\\s*=\\s*\"dprint/v(?<currentValue>\\d+\\.\\d+\\.\\d+)-headless\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/kjanat/tombi",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^dprint/v(?<version>\\d+\\.\\d+\\.\\d+)-headless$"
    }
  ],
  "packageRules": [
    {
      "description": "Merge non-major updates with GitHub's auto-merge, which waits for the CI checks the master ruleset requires.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require dashboard approval before opening major upgrade PRs.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "All Tombi crates in one PR, merged by hand: merging releases (release.yml).",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["https://github.com/kjanat/tombi"],
      "groupName": "tombi",
      "automerge": false
    }
  ]
}
